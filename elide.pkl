amends "elide:project.pkl"
import "elide:Sources.pkl" as src
import "pkl:json" as json

local versions = new json.Parser {}.parse(read("file:tools/versions.json").text)
name = "dokar"
version = read("file:.version").text.trim()
description = "Rust native transport for Netty, the JVM, and Native Image"

jvm {
  target = versions.jvm_release
  java { release = versions.jvm_release }
  features { testing = false }
}

sources {
  ["main"] = new src.SourceSetSpec {
    paths {
      "packages/api/src/main/java/**/*.java"
      "packages/ffm/src/main/java/**/*.java"
      "packages/native-image/src/main/java/**/*.java"
      "packages/netty/src/main/java/**/*.java"
    }
  }
}

dependencies {
  maven {
    packages {
      "io.netty:netty-transport:\(versions.netty)"
      "io.netty:netty-handler:\(versions.netty)"
      "io.netty:netty-codec-http2:\(versions.netty)"
      "io.netty:netty-transport-native-unix-common:\(versions.netty)"
      "org.graalvm.sdk:nativeimage:\(versions.graalvm_sdk)"
      "org.graalvm.sdk:word:\(versions.graalvm_sdk)"
      "org.jspecify:jspecify:\(versions.jspecify)"
      "com.google.errorprone:error_prone_core:\(versions.error_prone):with-dependencies"
      "com.uber.nullaway:nullaway:\(versions.nullaway)"
      "org.checkerframework:checker:\(versions.checker)"
      "org.checkerframework:checker-util:\(versions.checker)"
      "org.checkerframework:checker-qual:\(versions.checker)"
      "io.github.eisop:dataflow-errorprone:\(versions.dataflow)"
      "org.checkerframework:dataflow-nullaway:\(versions.nullaway_dataflow)"
      "org.jacoco:org.jacoco.agent:\(versions.jacoco):runtime"
      "org.jacoco:org.jacoco.cli:\(versions.jacoco):nodeps"
      "com.google.googlejavaformat:google-java-format:\(versions.java_format):all-deps"
    }
  }
}
